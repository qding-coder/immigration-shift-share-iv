. /*===========================================================================
>   STEP 1: Process each decade → CZ x origin intermediates
>   Output per decade: cz_o_YEAR.dta
>   Unit: commuting zone x origin-country group
>   Variables: czone, kmp_ctry, year, pop (adj. pop sum), wage (mean hourly)
> ===========================================================================*/
. di "===== STEP 1: Decade processing ====="
===== STEP 1: Decade processing =====

. 
. foreach yr in 1970 1980 1990 2000 2010 {
  2. 
.     di "--- Processing `yr' ---"
  3.     use "$clean/ipums_raw_all.dta", clear
  4.     keep if year == `yr'
  5. 
.     *-- (a) Sample restrictions
.     drop if statefip == 2 | statefip == 15   // AK, HI
  6.     drop if inlist(gq, 0, 3, 4)             // group quarters
  7.     drop if age < 16
  8. 
.     *-- (b) Geography merge → commuting zones
.     if `yr' == 1970 {
  9.         rename cntygp97 cty_grp70
 10.         joinby cty_grp70 using "$raw/cw_ctygrp1970_czone_corr.dta"
 11.         gen aperwt = afact * perwt
 12.     }
 13.     else if `yr' == 1980 {
 14.         gen ctygrp1980 = 1000 * statefip + cntygp98
 15.         joinby ctygrp1980 using "$raw/cw_ctygrp1980_czone_corr.dta"
 16.         gen aperwt = afactor * perwt
 17.     }
 18.     else if `yr' == 1990 {
 19.         gen puma1990 = 10000 * statefip + puma
 20.         joinby puma1990 using "$raw/cw_puma1990_czone.dta"
 21.         gen aperwt = afactor * perwt
 22.     }
 23.     else {
 24.         // 2000 and 2010 both use the 2000 PUMA crosswalk
.         gen puma2000 = 10000 * statefip + puma
 25.         joinby puma2000 using "$raw/cw_puma2000_czone.dta"
 26.         gen aperwt = afactor * perwt
 27.     }
 28. 
.     *-- (c) Origin classification
.     merge m:1 bpld using "$raw/cw_bpld_kmp.dta", keep(match) nogen
 29.     drop if kmp_ctry == 82   // drop "other/unspecified"
 30. 
.     *-- (d) Hourly wage construction
.     // Weeks worked
.     if `yr' >= 1990 {
 31.         gen weeks = wkswork1
 32.         replace weeks = . if weeks == 0
 33.     }
 34.     else {
 35.         // Intervalled wkswork2 → midpoints
.         gen weeks = .
 36.         replace weeks = 7    if wkswork2 == 1   // 1-13
 37.         replace weeks = 20   if wkswork2 == 2   // 14-26
 38.         replace weeks = 33   if wkswork2 == 3   // 27-39
 39.         replace weeks = 43.5 if wkswork2 == 4   // 40-47
 40.         replace weeks = 48.5 if wkswork2 == 5   // 48-49
 41.         replace weeks = 51   if wkswork2 == 6   // 50-52
 42.     }
 43. 
.     // Usual hours per week (continuous in this extract for all years)
.     gen hours = uhrswork
 44.     replace hours = . if uhrswork == 0 | uhrswork >= 99
 45. 
.     // Annual wage income
.     replace incwage = . if incwage >= 999998
 46.     replace incwage = . if incwage <= 0
 47. 
.     // Hourly wage; drop top 1%
.     gen wage = incwage / (weeks * hours)
 48.     replace wage = . if missing(weeks) | missing(hours)
 49.     replace wage = . if wage <= 0
 50.     qui sum wage [aw=aperwt], detail
 51.     replace wage = . if wage > r(p99)
 52. 
.     *-- (e) Collapse to CZ x origin
.     collapse (rawsum) pop  = aperwt ///
>              (mean)   wage [pw=aperwt], ///
>              by(czone kmp_ctry year)
 53. 
.     label var pop  "Adjusted population"
 54.     label var wage "Mean hourly wage"
 55. 
.     save "$clean/cz_o_`yr'.dta", replace
 56.     di "  cz_o_`yr'.dta: N=`=_N'"
 57. }
